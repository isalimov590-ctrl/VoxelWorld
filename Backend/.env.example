# Application
APP_NAME=VoxelWorld Backend
APP_VERSION=0.1.0
DEBUG=True

# Database
DATABASE_URL=postgresql+asyncpg://voxelworld:password@localhost:5432/voxelworld

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000

# Game Server
GAME_SERVER_SECRET=game-server-secret-change-this
